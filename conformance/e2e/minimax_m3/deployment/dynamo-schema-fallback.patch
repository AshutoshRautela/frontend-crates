diff --git a/lib/llm/src/preprocessor/structural_tag/v2.rs b/lib/llm/src/preprocessor/structural_tag/v2.rs
index fc54150f5d..6b7e916f0a 100644
--- a/lib/llm/src/preprocessor/structural_tag/v2.rs
+++ b/lib/llm/src/preprocessor/structural_tag/v2.rs
@@ -25,6 +25,33 @@ impl StructuralTagBuilder {
         .map(Self)
     }
 
+    pub(super) fn supports_request(
+        self,
+        request: &StructuralTagBuildRequest<'_>,
+    ) -> anyhow::Result<bool> {
+        if matches!(request.tool_choice, ToolChoice::None) {
+            return Ok(true);
+        }
+        let enforce_all = matches!(
+            request.schema_mode,
+            dynamo_parsers::tool_calling::StructuralTagSchemaMode::Strict
+        );
+        Ok(request
+            .tools
+            .iter()
+            .filter(|tool| match request.tool_choice {
+                ToolChoice::Named(name) => &tool.name == name,
+                _ => true,
+            })
+            .all(|tool| {
+                (!enforce_all && !tool.strict.unwrap_or(true))
+                    || tool
+                        .parameters
+                        .as_ref()
+                        .is_none_or(|schema| self.0.supports_schema(schema))
+            }))
+    }
